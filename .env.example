# Keys apps upload with, comma separated, 16+ characters each.
# They ship inside test builds: rotate them per testing round.
# Generate one with: openssl rand -hex 24
TETHER_DEBUG_INGEST_KEYS=

# Dashboard login (HTTP basic auth). Password: 12+ characters.
TETHER_DEBUG_ADMIN_USER=admin
TETHER_DEBUG_ADMIN_PASSWORD=

# Days to keep logs; 0 keeps everything.
TETHER_DEBUG_RETENTION_DAYS=14

# Address the portal port is published on. 127.0.0.1 keeps it local (use with the
# https profile or your own reverse proxy); 0.0.0.0 exposes it on the LAN over plain HTTP.
TETHER_DEBUG_BIND=127.0.0.1

# Public name for the https profile, e.g. logs.example.com
TETHER_DEBUG_DOMAIN=
